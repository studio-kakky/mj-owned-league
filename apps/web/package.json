{
  "name": "web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "worker:dev": "wrangler dev --local --persist-to .wrangler/state",
    "worker:types": "wrangler types",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:apply:local": "wrangler d1 migrations apply janroku-local --local --persist-to .wrangler/state",
    "drizzle:apply:remote": "wrangler d1 migrations apply janroku-local --remote",
    "drizzle:apply": "pnpm drizzle:apply:local"
  },
  "dependencies": {
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "better-auth": "1.6.11",
    "drizzle-orm": "0.45.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-plugin": "1.167.35",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "drizzle-zod": "0.8.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6",
    "wrangler": "4.91.0"
  }
}
