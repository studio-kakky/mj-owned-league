# =============================================================================
# Local Worker secrets (read by `@cloudflare/vite-plugin` during `vite dev`)
# =============================================================================
# Copy this file to `.dev.vars` (which is gitignored) and adjust values as
# needed. Do NOT put real production secrets here — `.dev.vars` is for local
# development only. Real secrets are managed via `wrangler secret put <KEY>`.
# -----------------------------------------------------------------------------

# Better Auth signing secret. Any non-empty random string is fine for local dev.
BETTER_AUTH_SECRET=dev-secret-change-me

# Base URL Better Auth uses when constructing OAuth redirect URIs. This must
# match the dev origin — `vite.config.ts` pins the dev server to port 8787.
# In production it must point at the real public origin.
BETTER_AUTH_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# Google OAuth client credentials
# -----------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and register:
#   - Authorized redirect URI:  http://localhost:8787/api/auth/callback/google
#   - Authorized JavaScript origin: http://localhost:8787
#
# Local boot succeeds with empty values, but actual Google sign-in fails until
# both fields are populated.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
